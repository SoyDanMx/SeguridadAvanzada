# --- DATABASE (Prisma + Supabase PostgreSQL) ---
# En Supabase: Project Settings > Database > Connection string (URI)
# Usa el "Connection pooling" para Serverless (puerto 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- CRON (sincronización nocturna) ---
# Genera un secreto: openssl rand -hex 32
CRON_SECRET=""

# --- SUPABASE ---
# Proyecto: https://supabase.com/dashboard/project/lxacjidshxyiqsicgqke
# Obtén las claves en: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://lxacjidshxyiqsicgqke.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- SYSCOM ---
# Documentación: https://developers.syscom.mx/docs
SYSCOM_CLIENT_ID=""
SYSCOM_CLIENT_SECRET=""
# Opcional. Por defecto: https://developers.syscom.mx (usa /api/v1/productos)
# SYSCOM_API_BASE="https://api.syscom.mx"

# --- TIENDANUBE (App ID 26095) ---
# Para obtener el token: POST /api/tiendanube/token con body { "code": "..." }
# El code sale al instalar/reautorizar la app (redirect ?code=xxx) y expira en 5 min.
TIENDANUBE_CLIENT_ID="26095"
TIENDANUBE_CLIENT_SECRET=""
# Después de intercambiar el code por token, rellena con la respuesta:
TIENDANUBE_ACCESS_TOKEN=""
TIENDANUBE_STORE_ID=""

# --- APIFY (web scraping en la nube) ---
# Opcional. Para /api/apify-scrape (Syscom + Seguridad Avanzada).
# Obtén el token en https://console.apify.com/account/integrations
APIFY_TOKEN=""

# --- NEGOCIO ---
PROFIT_MARGIN="1.30"
EXCHANGE_RATE_USD_MXN="18.50"

# --- CONTACTO (formulario EmailJS) ---
# Opcional. Sin estas variables el formulario de /contacto muestra mensaje para escribir por email/WhatsApp.
# Crea cuenta en https://www.emailjs.com y configura un servicio + plantilla (campos: user_name, user_email, user_phone, message).
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- WHATSAPP (botón flotante, hero y enlaces) ---
# Opcional. Por defecto: 525636741156 y mensaje por defecto.
# NEXT_PUBLIC_WHATSAPP_NUMBER=525636741156
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, necesito información...
# Mensaje para el botón "Solicitar servicio" del hero (diferente al flotante)
# NEXT_PUBLIC_WHATSAPP_SERVICE_MESSAGE=Hola, me gustaría solicitar un servicio...
