<script>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('branchSearchInput');
    var cards = document.querySelectorAll('.ws-branch-card');

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        var term = e.target.value.toLowerCase().trim();
        cards.forEach(function(card) {
          var cityData = card.getAttribute('data-city') || '';
          var cityName = card.querySelector('.ws-branch-name') ? card.querySelector('.ws-branch-name').innerText.toLowerCase() : '';
          if (!term || cityData.includes(term) || cityName.includes(term)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  });
</script>

