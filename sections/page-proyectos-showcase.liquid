{% comment %}
  Página de Proyectos B2B y Vanguardia Tecnológica
{% endcomment %}

<style>
  :root {
    /* Tema Claro (Blanco permanente) */
    --proy-bg: #ffffff;
    --proy-bg-alt: #f8fafc;
    --proy-text: #334155;
    --proy-title: #0f172a;
    --proy-accent: #2A75D3;
    --proy-accent-hover: #1d4ed8;
    --proy-border: rgba(0, 0, 0, 0.1);
    --proy-hero-gradient: radial-gradient(circle at top center, rgba(42,117,211,0.1) 0%, #ffffff 70%);
    --proy-cta-gradient: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .proyectos-page {
    background-color: var(--proy-bg);
    color: var(--proy-text);
    font-family: inherit;
    line-height: 1.6;
    overflow: hidden;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* --- HERO SECTION --- */
  .proy-hero {
    position: relative;
    padding: 8rem 2rem;
    text-align: center;
    background: var(--proy-hero-gradient);
  }

  .proy-hero::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--proy-text) 1px, transparent 1px);
    background-size: 30px 30px;
    opacity: 0.1;
    pointer-events: none;
  }

  .proy-hero__content {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    z-index: 2;
  }

  .proy-hero__tag {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(42, 117, 211, 0.1);
    color: var(--proy-accent);
    border: 1px solid rgba(42, 117, 211, 0.3);
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .proy-hero__title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    color: var(--proy-title);
    margin: 0 0 1.5rem;
    line-height: 1.1;
  }

  .proy-hero__title span {
    background: linear-gradient(to right, #3b82f6, #1d4ed8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .proy-hero__subtitle {
    font-size: 1.2rem;
    max-width: 700px;
    margin: 0 auto 3rem;
  }

  .proy-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background-color: #25D366;
    color: #fff;
    padding: 1.2rem 2.5rem;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 25px -5px rgba(37, 211, 102, 0.4);
  }

  .proy-hero__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px -5px rgba(37, 211, 102, 0.6);
  }

  /* --- GRID DE ESPECIALIDADES --- */
  .proy-grid-section {
    padding: 5rem 2rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  .proy-section-title {
    text-align: center;
    font-size: 2.2rem;
    color: var(--proy-title);
    margin-bottom: 4rem;
    font-weight: 700;
  }

  .proy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .proy-card {
    background: var(--proy-bg-alt);
    border: 1px solid var(--proy-border);
    border-radius: 12px;
    padding: 2.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .proy-card::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: var(--proy-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .proy-card:hover {
    transform: translateY(-5px);
    border-color: rgba(42, 117, 211, 0.3);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  }

  .proy-card:hover::after {
    transform: scaleX(1);
  }

  .proy-card__icon {
    width: 60px;
    height: 60px;
    background: rgba(42, 117, 211, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    color: var(--proy-accent);
  }

  .proy-card__icon svg {
    width: 30px;
    height: 30px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .proy-card__title {
    font-size: 1.4rem;
    color: var(--proy-title);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .proy-card__desc {
    font-size: 1rem;
  }

  /* --- METODOLOGÍA / PASOS --- */
  .proy-steps-section {
    background: var(--proy-bg-alt);
    padding: 6rem 2rem;
  }

  .proy-steps-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .proy-steps-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .proy-steps-list {
      flex-direction: row;
      justify-content: space-between;
      position: relative;
    }
    
    .proy-steps-list::before {
      content: "";
      position: absolute;
      top: 30px;
      left: 10%;
      right: 10%;
      height: 2px;
      background: rgba(42, 117, 211, 0.3);
      z-index: 1;
    }
  }

  .proy-step {
    position: relative;
    z-index: 2;
    text-align: center;
    flex: 1;
  }

  .proy-step__number {
    width: 60px;
    height: 60px;
    background: var(--proy-accent);
    color: #fff;
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    box-shadow: 0 0 0 10px var(--proy-bg-alt);
  }

  .proy-step__title {
    color: var(--proy-title);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  /* --- CTA FINAL --- */
  .proy-final-cta {
    padding: 8rem 2rem;
    text-align: center;
    background: var(--proy-cta-gradient);
  }

</style>

