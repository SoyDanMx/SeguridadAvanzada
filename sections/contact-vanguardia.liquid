{% comment %}
  SECCIÓN DE CONTACTO: ESTILO TIENDANUBE (Limpio y Minimalista)
{% endcomment %}

<style>
  .page-contacto-wrapper {
    max-width: 1200px;
    margin: 4rem auto;
    padding: 0 2rem;
    font-family: Arial, Helvetica, sans-serif;
    color: #333;
  }

  .page-contacto-title {
    font-size: 2.8rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 1rem;
    color: #222;
  }

  .page-contacto-intro {
    font-size: 1.4rem;
    line-height: 1.6;
    margin-bottom: 4rem;
    color: #555;
  }

  .contacto-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 5rem;
  }

  .contacto-form-col {
    flex: 1 1 500px;
  }

  .contacto-info-col {
    flex: 1 1 400px;
  }

  /* Formulario (Estilo Tiendanube) */
  .form-group {
    margin-bottom: 2rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.8rem;
    font-size: 1.3rem;
    font-weight: 600;
    color: #444;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.2rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1.4rem;
    font-family: inherit;
    box-sizing: border-box;
    background-color: #fff;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #3b82f6; /* Azul al hacer clic */
    outline: none;
  }

  .form-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .btn-submit {
    background-color: #333; /* Botón oscuro clásico */
    color: white;
    padding: 1.4rem 3rem;
    font-size: 1.4rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    text-transform: uppercase;
    transition: background-color 0.2s;
    width: 100%;
  }

  .btn-submit:hover {
    background-color: #555;
  }

  .form-success {
    background: #d4edda;
    color: #155724;
    padding: 1.5rem;
    border-radius: 4px;
    margin-bottom: 2rem;
    font-size: 1.4rem;
    border: 1px solid #c3e6cb;
  }

  /* Información de Contacto */
  .contacto-info-col h3 {
    font-size: 1.8rem;
    margin-top: 0;
    margin-bottom: 2rem;
    font-weight: 600;
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 1rem;
    color: #222;
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem 0;
  }

  .info-list li {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.8rem;
    font-size: 1.4rem;
    line-height: 1.6;
    color: #555;
  }

  .info-list svg {
    width: 22px;
    height: 22px;
    margin-right: 1.5rem;
    fill: #666;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .map-container {
    width: 100%;
    height: 250px;
    background-color: #eee;
    border: 1px solid #ddd;
    border-radius: 4px;
    overflow: hidden;
  }

  .map-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Binational HQ Tabs styling */
  .binational-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    border-bottom: 2px solid #eaeaea;
    padding-bottom: 0.5rem;
  }

  .tab-btn {
    background: none;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1.4rem;
    font-weight: bold;
    cursor: pointer;
    color: #888;
    transition: all 0.3s ease;
    border-radius: 4px;
  }

  .tab-btn:hover {
    color: #222;
    background-color: #f5f5f5;
  }

  .tab-btn.active {
    color: #2A75D3;
    border-bottom: 3px solid #2A75D3;
    background-color: rgba(42, 117, 211, 0.05);
  }

  .hq-content {
    display: none;
  }

  .hq-content.active {
    display: block;
  }

  /* Fade animation for maps */
  .animate-fade {
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="page-contacto-wrapper">
  
  <h1 class="page-contacto-title">Contacto</h1>
  
  <div class="page-contacto-intro">
    <p>Somos integradores globales de proyectos de tecnología y seguridad industrial. Contamos con operaciones binacionales en México y Estados Unidos para gestionar tus compras corporativas y proyectos de forma eficiente.</p>
  </div>

  <div class="contacto-layout">
    
