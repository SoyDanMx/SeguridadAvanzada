<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('marcaSearchInput');
    const searchClear = document.getElementById('marcaSearchClear');
    const azBar = document.getElementById('marcasAzBar');
    const azButtons = azBar ? azBar.querySelectorAll('.marcas-az-btn') : [];
    const cards = document.querySelectorAll('.marca-dir-card');
    const countEl = document.getElementById('marcasVisibleCount');
    const emptyState = document.getElementById('marcasEmptyState');

    let currentLetter = 'all';
    let currentSearch = '';

    function filterBrands() {
      let visible = 0;
      cards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        const cat = card.getAttribute('data-category') || '';
        const letter = card.getAttribute('data-letter') || '';

        const matchesLetter = (currentLetter === 'all' || letter === currentLetter);
        const matchesSearch = (!currentSearch || name.includes(currentSearch) || cat.includes(currentSearch));

        if (matchesLetter && matchesSearch) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = visible;
      if (emptyState) {
        if (visible === 0) {
          emptyState.style.display = 'block';
        } else {
          emptyState.style.display = 'none';
        }
      }
    }

    // Eventos de Búsqueda
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentSearch = e.target.value.toLowerCase().trim();
        if (currentSearch.length > 0) {
          if (searchClear) searchClear.style.display = 'flex';
          currentLetter = 'all';
          azButtons.forEach(b => b.classList.remove('active'));
          if (azButtons[0]) azButtons[0].classList.add('active');
        } else {
          if (searchClear) searchClear.style.display = 'none';
        }
        filterBrands();
      });
    }

    if (searchClear) {
      searchClear.addEventListener('click', function() {
        searchInput.value = '';
        currentSearch = '';
        searchClear.style.display = 'none';
        searchInput.focus();
        filterBrands();
      });
    }

    // Eventos de Filtro A-Z
    azButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        azButtons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentLetter = this.getAttribute('data-letter');
        filterBrands();
      });
    });

    // Soporte para URL Hash o Parámetro: ?marca=hikvision o #hikvision
    const urlParams = new URLSearchParams(window.location.search);
    const marcaParam = urlParams.get('marca') || window.location.hash.replace('#', '');
    if (marcaParam) {
      const cleanTarget = marcaParam.toLowerCase().trim();
      const targetCard = document.getElementById(cleanTarget);
      if (targetCard) {
        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('highlight');
        }, 300);
      } else if (searchInput) {
        searchInput.value = marcaParam;
        currentSearch = cleanTarget;
        if (searchClear) searchClear.style.display = 'flex';
        filterBrands();
      }
    }
  });
</script>

