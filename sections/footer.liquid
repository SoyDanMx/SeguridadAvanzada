{% comment %}
  FOOTER PROFESIONAL SÓLIDO TECH - SEGURIDAD AVANZADA
  Inspirado exactamente en el diseño de alta densidad y tipografía sólida de Zegucom / Syscom.
  Tipografía geométrica sólida Roboto / Inter en alto contraste, barra superior de redes y métodos de pago,
  columnas organizadas con enlaces sólidos, modales corporativos (Nuo Networks USA y Tulbox Pro), y sellos oficiales de confianza.
{% endcomment %}
  /* Base del Footer con Tipografía Sólida y Letra Más Grande */
  .ws-footer-root {
    background-color: #13253e;
    color: #fbf9f9;
    font-family: 'Roboto', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    position: relative;
    z-index: 10;
    font-size: 1.12rem;
    line-height: 1.55;
  }

  .ws-footer-container {
    max-width: 1420px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* =========================================================
     BARRA SUPERIOR: REDES SOCIALES (IZQ) & MÉTODOS DE PAGO (DER)
     ========================================================= */
  .ws-footer-topbar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .ws-footer-topbar {
      flex-direction: row;
      gap: 2rem;
    }
  }

  /* Iconos Sociales en Botones Cuadrados Sólidos */
  .ws-topbar-socials {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ws-topbar-social-btn {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    border: 1.5px solid rgba(255, 255, 255, 0.65);
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ws-topbar-social-btn:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #13253e;
    transform: translateY(-2px);
  }

  .ws-topbar-social-btn.whatsapp-top-btn:hover {
    background: #22c55e;
    border-color: #22c55e;
    color: #ffffff;
  }

  .ws-topbar-social-btn svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* Métodos de Pago a la Derecha en Blanco Monocromático Nítido */
  .ws-topbar-payments {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ws-pay-mono {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    opacity: 0.95;
    font-weight: 800;
    letter-spacing: 0.03em;
    font-size: 1.1rem;
    line-height: 1;
    transition: opacity 0.2s ease;
  }

  .ws-pay-mono:hover {
    opacity: 1;
  }

  .ws-pay-mono svg {
    height: 26px;
    width: auto;
    fill: #ffffff;
  }

  /* =========================================================
     CUERPO PRINCIPAL: 4 COLUMNAS DE ALTA DENSIDAD
     ========================================================= */
  .ws-footer-main {
    padding: 3.5rem 0 3rem;
  }

  .ws-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .ws-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .ws-footer-grid {
      grid-template-columns: 1.5fr 1.15fr 1.15fr 1.1fr;
      gap: 2.75rem;
    }
  }

  /* Encabezados Sólidos Grandes */
  .ws-col-heading {
    color: #ffffff;
    font-size: 1.55rem;
    font-weight: 800;
    margin: 0 0 1.35rem 0;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  /* Enlaces de Texto Sólido Grande */
  .ws-solid-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ws-solid-link {
    color: #fbf9f9;
    font-weight: 600;
    font-size: 1.18rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.15s ease, transform 0.15s ease;
    line-height: 1.45;
  }

  .ws-solid-link:hover {
    color: #38bdf8;
    text-decoration: underline;
  }

  /* Subcolumnas para Información (Estilo Zegucom) */
  .ws-info-subcols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 500px) {
    .ws-info-subcols {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }

  .ws-utility-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fbf9f9;
    font-weight: 600;
    font-size: 1.18rem;
    text-decoration: none;
    transition: color 0.15s ease;
    line-height: 1.45;
  }

  .ws-utility-item:hover {
    color: #38bdf8;
    text-decoration: underline;
  }

  .ws-utility-icon {
    display: inline-flex;
    color: #ffffff;
    flex-shrink: 0;
  }

  .ws-utility-icon svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* Columna 1 Resumen de Identidad & Afiliaciones */
  .ws-brand-summary {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .ws-brand-desc {
    color: #e2e8f0;
    font-size: 1.08rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    font-weight: 400;
  }

  .ws-brand-desc strong {
    color: #ffffff;
    font-weight: 800;
  }

  .ws-corp-affiliation-title {
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 0.75rem;
  }

  .ws-corp-chips {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ws-corp-chip-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #fbf9f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ws-corp-chip-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(56, 189, 248, 0.5);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .ws-corp-chip-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .ws-corp-chip-logo {
    width: 38px;
    height: 38px;
    object-fit: contain;
    border-radius: 8px;
    background: #020617;
    padding: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
  }

  .ws-corp-chip-logo.ws-tulbox-logo {
    background: #ffffff;
    padding: 4px;
  }

  .ws-corp-chip-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.3;
  }

  .ws-corp-chip-name {
    font-size: 1.12rem;
    font-weight: 800;
    color: #ffffff;
  }

  .ws-corp-chip-desc {
    font-size: 0.92rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .ws-corp-arrow {
    color: #94a3b8;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .ws-corp-chip-btn:hover .ws-corp-arrow {
    color: #38bdf8;
    transform: translateX(3px);
  }

  /* Columna 3: Tarjeta Cotizador Rápido Pro */
  .ws-club-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.35rem;
  }

  .ws-shield-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ws-shield-logo {
    width: 155px;
    height: auto;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
  }

  .ws-club-btn-solid {
    display: inline-block;
    background: #1976d2;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    padding: 0.8rem 2.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    text-transform: uppercase;
  }

  .ws-club-btn-solid:hover {
    background: #1565c0;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(25, 118, 210, 0.5);
  }

  .ws-club-subtext {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
    font-weight: 500;
  }

  /* Columna 4: Certificaciones y Confianza */
  .ws-trust-box {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .ws-google-rating-wrap {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: opacity 0.2s ease;
  }

  .ws-google-rating-wrap:hover {
    opacity: 0.9;
  }

  .ws-google-header-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ws-google-score-num {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .ws-google-stars-row {
    display: flex;
    gap: 2px;
    color: #fabb05;
  }

  .ws-google-stars-row svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .ws-google-caption {
    color: #cbd5e1;
    font-size: 0.95rem;
    text-decoration: underline;
    margin-top: 0.35rem;
    display: block;
    font-weight: 600;
  }

  /* Badges de Certificación */
  .ws-badges-column {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ws-digicert-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #ffffff;
    color: #1e293b;
    padding: 0.55rem 1rem;
    border-radius: 20px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    width: fit-content;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  }

  .ws-digicert-badge svg {
    width: 24px;
    height: 24px;
  }

  .ws-extra-guarantees {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.35rem;
    font-size: 1.02rem;
    color: #e2e8f0;
    font-weight: 500;
  }

  .ws-extra-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ws-extra-item svg {
    width: 18px;
    height: 18px;
    color: #38bdf8;
    flex-shrink: 0;
  }

  /* =========================================================
     SUBFOOTER: ENLACES LEGALES HORIZONTALES CON PIPES & COPYRIGHT
     ========================================================= */
  .ws-subfooter-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 2rem 0 2.5rem;
    text-align: center;
  }

  .ws-legal-pills-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 1.1rem;
  }

  .ws-legal-pill-link {
    color: #fbf9f9;
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .ws-legal-pill-link:hover {
    color: #38bdf8;
    text-decoration: underline;
  }

  .ws-legal-separator {
    color: rgba(255, 255, 255, 0.45);
    font-size: 1.15rem;
    user-select: none;
  }

  .ws-cookies-notice-text {
    color: #cbd5e1;
    font-size: 1.08rem;
    line-height: 1.6;
    max-width: 1100px;
    margin: 0 auto 1rem;
    font-weight: 400;
  }

  .ws-cookies-notice-text a {
    color: #ffffff;
    text-decoration: underline;
    font-weight: 600;
  }

  .ws-copyright-text {
    color: #94a3b8;
    font-size: 1.12rem;
    line-height: 1.65;
    margin: 0;
  }

  .ws-copyright-text strong {
    color: #ffffff;
    font-weight: 700;
  }

  /* =========================================================
     MODALES CORPORATIVOS (DELAWARE US & TULBOX PRO)
     ========================================================= */
  .usa-modal-overlay,
  .tulbox-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 1.5rem;
  }

  .usa-modal-overlay.active,
  .tulbox-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .usa-modal-container,
  .tulbox-modal-container {
    background: #0f172a;
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 16px;
    width: 100%;
    max-width: 560px;
    padding: 2.25rem 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    color: #ffffff;
    font-family: 'Roboto', 'Inter', sans-serif;
  }

  .tulbox-modal-container {
    background: #ffffff;
    color: #0f172a;
    border-color: rgba(124, 58, 237, 0.25);
  }

  .usa-modal-overlay.active .usa-modal-container,
  .tulbox-modal-overlay.active .tulbox-modal-container {
    transform: scale(1);
  }

  .usa-modal-close,
  .tulbox-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .tulbox-modal-close {
    background: #f1f5f9;
    color: #64748b;
    border: none;
  }

  .usa-modal-close:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .tulbox-modal-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
</style>

