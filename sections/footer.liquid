{% comment %}
  FOOTER MODERNO Y DINÁMICO - SEGURIDAD AVANZADA
  Incluye: Info empresa, Whatsapp dinámico, Enlaces, Newsletter y Reseñas de Google Integradas.
{% endcomment %}

<style>
  .footer-moderno {
    background-color: #0f172a; 
    color: #94a3b8;
    padding: 5rem 2rem 2rem;
    font-family: inherit;
    border-top: 4px solid #2563eb; 
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.5fr 1.5fr; /* Ajustado para dar espacio a las reseñas */
      gap: 3rem;
    }
  }

  .footer-heading {
    color: #f8fafc;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Info Empresa */
  .footer-brand h2 {
    color: #ffffff;
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
  }
  
  .footer-brand p {
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .footer-contact-list svg {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    stroke: #3b82f6; 
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-contact-list a {
    color: #e2e8f0;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact-list a:hover {
    color: #3b82f6;
  }

  /* Badge General de Google */
  .footer-reviews-badge {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    background-color: #1e293b;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid #334155;
    transition: transform 0.3s ease, border-color 0.3s ease;
    text-decoration: none;
  }

  .footer-reviews-badge:hover {
    transform: translateY(-3px);
    border-color: #3b82f6;
  }

  .google-logo-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .footer-reviews-stars {
    display: flex;
    gap: 2px;
    margin-bottom: 2px;
  }

  .footer-reviews-stars svg {
    width: 16px;
    height: 16px;
    fill: #FABB05; 
  }

  .footer-reviews-text {
    font-size: 0.9rem;
    line-height: 1.3;
    color: #94a3b8;
  }

  .footer-reviews-text strong {
    color: #ffffff;
    font-size: 1.05rem;
  }

  /* Tarjetas de Reseñas Individuales */
  .review-card {
    background-color: #1e293b;
    border-left: 3px solid #3b82f6;
    padding: 1.2rem;
    border-radius: 6px;
    margin-bottom: 1.2rem;
  }

  .review-card-text {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #cbd5e1;
    font-style: italic;
    margin-bottom: 0.8rem;
  }

  .review-card-author {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .review-card-name {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Enlaces */
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 1rem;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 1.05rem;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #3b82f6;
    transform: translateX(5px);
  }

  /* Newsletter */
  .footer-newsletter-text {
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .footer-form-group {
    display: flex;
    position: relative;
  }

  .footer-input {
    width: 100%;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    border: 1px solid #334155;
    background-color: #1e293b;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .footer-input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  .footer-btn {
    position: absolute;
    right: 5px;
    top: 5px;
    bottom: 5px;
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .footer-btn:hover {
    background-color: #2563eb;
  }

  /* Bottom */
  .footer-bottom {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-socials {
    display: flex;
    gap: 1.5rem;
  }

  .footer-socials a {
    color: #64748b;
    transition: color 0.3s ease, transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e293b;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .footer-socials a:hover {
    color: #ffffff;
    background: #3b82f6;
    transform: translateY(-3px);
  }

  .footer-socials svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
</style>

<footer class="footer-moderno">
  <div class="footer-container">
    <div class="footer-grid">
      
      <div class="footer-brand">
        <h2>{{ shop.name }}</h2>
        <p>{{ section.settings.company_description }}</p>
        
        <ul class="footer-contact-list">
          {% if section.settings.phone != blank %}
          <li>
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <div>
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
              {% if section.settings.whatsapp != blank %}
                <br><a href="https://wa.me/{{ section.settings.whatsapp | remove: ' ' | remove: '+' }}?text=Deseo%20Informacion%20de%20sistemas%20de%20seguridad" target="_blank" style="color: #25D366; font-weight: 600;">WhatsApp: {{ section.settings.whatsapp }}</a>
              {% endif %}
            </div>
          </li>
          {% endif %}
          
          {% if section.settings.email != blank %}
          <li>
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </li>
          {% endif %}
        </ul>

        {% if section.settings.show_google_reviews %}
        {% assign reviews_url = section.settings.google_reviews_link | default: "https://share.google/Uoxv3RTwBKQKuGyHZ" %}
        <a href="{{ reviews_url }}" target="_blank" class="footer-reviews-badge">
          <svg class="google-logo-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <div>
            <div class="footer-reviews-stars">
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </div>
            <div class="footer-reviews-text">
              <strong>{{ section.settings.google_reviews_score }}</strong> <br>
              Opiniones reales
            </div>
          </div>
        </a>
        {% endif %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'link_list' -%}
            <div>
              <h3 class="footer-heading">{{ block.settings.heading | default: block.settings.menu.title }}</h3>
              <ul class="footer-links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'google_reviews_column' -%}
            <div>
              <h3 class="footer-heading">{{ block.settings.heading }}</h3>
              
              {% if block.settings.text_1 != blank %}
              <div class="review-card">
                <div class="review-card-text">"{{ block.settings.text_1 }}"</div>
                <div class="review-card-author">
                  <span class="review-card-name">
                    <svg style="width:16px; height:16px; fill:#4285F4;" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
                    {{ block.settings.author_1 }}
                  </span>
                  <div class="footer-reviews-stars">
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  </div>
                </div>
              </div>
              {% endif %}

              {% if block.settings.text_2 != blank %}
              <div class="review-card">
                <div class="review-card-text">"{{ block.settings.text_2 }}"</div>
                <div class="review-card-author">
                  <span class="review-card-name">
                    <svg style="width:16px; height:16px; fill:#4285F4;" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
                    {{ block.settings.author_2 }}
                  </span>
                  <div class="footer-reviews-stars">
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  </div>
                </div>
              </div>
              {% endif %}
            </div>

        {%- endcase -%}
      {%- endfor -%}

      <div>
        <h3 class="footer-heading">{{ section.settings.newsletter_heading }}</h3>
        <p class="footer-newsletter-text">{{ section.settings.newsletter_text }}</p>
        
        {%- form 'customer', id: 'ContactFooter', class: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-form-group">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="footer-input"
              value="{{ form.email }}"
              aria-required="true"
              placeholder="Ingresa tu correo"
              required
            >
            <button type="submit" class="footer-btn" name="commit">
              Unirse
            </button>
          </div>
        {%- endform -%}
      </div>

    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. Todos los derechos reservados.
      </div>
      <div class="footer-socials">
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" target="_blank"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Moderno Tech",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "company_description",
      "label": "Descripción de la empresa",
      "default": "Integradores de proyectos en seguridad y tecnología."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono de Oficina",
      "default": "55 6728 3971"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "Número de WhatsApp",
      "default": "55 5636741156"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo Electrónico",
      "default": "proyectos@seguridad-avanzada.com"
    },
    {
      "type": "checkbox",
      "id": "show_google_reviews",
      "label": "Mostrar insignia General de Google",
      "default": true
    },
    {
      "type": "url",
      "id": "google_reviews_link",
      "label": "Link de Google Reviews"
    },
    {
      "type": "text",
      "id": "google_reviews_score",
      "label": "Calificación General",
      "default": "5.0 Excelente"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Título Newsletter",
      "default": "Mantente Actualizado"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Texto Newsletter",
      "default": "Suscríbete para recibir novedades."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menú de Enlaces",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Enlaces Rápidos"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú"
        }
      ]
    },
    {
      "type": "google_reviews_column",
      "name": "Columna de Reseñas",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título de columna",
          "default": "Nuestros Clientes"
        },
        {
          "type": "header",
          "content": "Reseña 1"
        },
        {
          "type": "text",
          "id": "author_1",
          "label": "Nombre del cliente",
          "default": "Carlos Mendoza"
        },
        {
          "type": "textarea",
          "id": "text_1",
          "label": "Opinión",
          "default": "Excelente servicio, la instalación de las cámaras fue muy profesional y rápida. Totalmente recomendados."
        },
        {
          "type": "header",
          "content": "Reseña 2"
        },
        {
          "type": "text",
          "id": "author_2",
          "label": "Nombre del cliente",
          "default": "Ana Gómez"
        },
        {
          "type": "textarea",
          "id": "text_2",
          "label": "Opinión",
          "default": "Resolvieron todas mis dudas sobre los sistemas de acceso. Muy buena atención y precios justos."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Moderno Tech",
      "blocks": [
        {
          "type": "link_list"
        },
        {
          "type": "google_reviews_column"
        }
      ]
    }
  ]
}
{% endschema %}