  Logo Seguridad Avanzada blanco, Afiliación a Nuo Networks, Inc., Métodos de pago, Legales y Redes Sociales.
{% endcomment %}

<style>
  .ws-footer-root {
    background-color: #090d14;
    color: #cbd5e1;
    font-family: inherit;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    position: relative;
    z-index: 10;
    font-size: 1.05rem;
  }

  .ws-footer-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 4.5rem 2rem 2.5rem;
  }

  /* Grid Principal de 4 Columnas */
  .ws-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .ws-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .ws-footer-grid {
      grid-template-columns: 1.4fr 1.05fr 1fr 1.15fr;
      gap: 3.5rem;
    }
  }

  /* Encabezados de Columna */
  .ws-footer-heading {
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Columna 1: Identidad de Marca */
  .ws-brand-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .ws-sa-logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #ffffff;
  }

  .ws-sa-logo-img {
    height: 64px;
    max-width: 280px;
    object-fit: contain;
    filter: brightness(0) invert(1); /* Asegura logo en blanco nítido */
  }

  .ws-sa-logo-fallback {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.7rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .ws-sa-logo-fallback svg {
    width: 40px;
    height: 40px;
    stroke: #3b82f6;
    fill: rgba(59, 130, 246, 0.15);
  }

  .ws-sa-logo-fallback strong {
    color: #3b82f6;
  }

  .ws-brand-desc {
    color: #e2e8f0;
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
  }

  .ws-brand-desc strong {
    color: #ffffff;
    font-weight: 700;
  }

  /* Afiliación a Nuo Networks */
  .ws-nuo-affiliation {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    margin-bottom: 1.25rem;
  }

  .ws-nuo-label {
    font-size: 1rem;
    color: #cbd5e1;
    margin: 0 0 0.75rem 0;
    font-weight: 600;
  }

  .ws-nuo-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .ws-nuo-logo-link:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.5));
  }

  .ws-nuo-logo-img {
    height: 52px;
    max-width: 240px;
    object-fit: contain;
    display: block;
  }

  /* Tarjetas Corporativas Compactas (Nuo USA & Tulbox) */
  .ws-corp-triggers {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ws-corp-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #e2e8f0;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ws-corp-pill:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.5);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .ws-corp-pill span {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .ws-corp-pill svg {
    width: 16px;
    height: 16px;
    stroke: #3b82f6;
    transition: transform 0.2s ease;
  }

  .ws-corp-pill:hover svg {
    transform: translateX(4px);
  }

  /* Columna 2: Métodos de Pago & Acciones */
  .ws-payment-text {
    color: #e2e8f0;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
  }

  .ws-divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin: 1.5rem 0;
  }

  .ws-action-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ws-action-link {
    color: #ffffff;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    transition: all 0.2s ease;
  }

  .ws-action-link:hover {
    color: #60a5fa;
    transform: translateX(5px);
  }

  .ws-action-link.highlight {
    color: #22c55e;
    font-size: 1.02rem;
  }

  .ws-action-link.highlight:hover {
    color: #4ade80;
    transform: translateX(5px);
  }

  /* Columna 3: Legales */
  .ws-legal-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ws-legal-links a {
    color: #cbd5e1;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0;
  }

  .ws-legal-links a:hover {
    color: #ffffff;
    transform: translateX(5px);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Columna 4: Redes Sociales & Contacto Oficial */
  .ws-social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .ws-social-item {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.35rem 0;
    transition: all 0.2s ease;
  }

  .ws-social-item:hover {
    color: #60a5fa;
    transform: translateX(5px);
  }

  .ws-social-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .ws-social-item:hover .ws-social-icon {
    background: #2563eb;
    color: #ffffff;
    transform: scale(1.05);
  }

  .ws-social-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Barra Inferior / Sub-Footer */
  .ws-subfooter {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .ws-subfooter {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  /* Google Reviews Badge Compacto */
  .ws-google-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ws-google-badge:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .ws-google-badge svg.google-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .ws-google-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 2px;
  }

  .ws-google-stars svg {
    width: 16px;
    height: 16px;
    fill: #FABB05;
  }

  .ws-google-badge-text {
    font-size: 0.9rem;
    line-height: 1.3;
    color: #cbd5e1;
  }

  .ws-google-badge-text strong {
    color: #ffffff;
    font-size: 1.05rem;
  }

  /* Newsletter */
  .ws-newsletter-box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 400px;
    width: 100%;
  }

  .ws-newsletter-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .ws-newsletter-input:focus {
    border-color: #3b82f6;
    background: rgba(255, 255, 255, 0.09);
  }

  .ws-newsletter-btn {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 0.75rem 1.4rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .ws-newsletter-btn:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }

  /* Copyright */
  .ws-copyright {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    text-align: center;
    width: 100%;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .ws-copyright {
      text-align: left;
      width: auto;
      margin-top: 0;
    }
  }

  /* Modales Estilo Glassmorphism (Delaware US y Tulbox) */
  .usa-modal-overlay,
  .tulbox-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 1.5rem;
  }

  .usa-modal-overlay.active,
  .tulbox-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .usa-modal-container,
  .tulbox-modal-container {
    background: #0f172a;
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 20px;
    width: 100%;
    max-width: 580px;
    padding: 2.5rem 2.25rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    color: #ffffff;
  }

  .tulbox-modal-container {
    background: #ffffff;
    color: #0f172a;
    border-color: rgba(124, 58, 237, 0.25);
  }

  .usa-modal-overlay.active .usa-modal-container,
  .tulbox-modal-overlay.active .tulbox-modal-container {
    transform: scale(1);
  }

  .usa-modal-close,
  .tulbox-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .tulbox-modal-close {
    background: #f1f5f9;
    color: #64748b;
    border: none;
  }

  .usa-modal-close:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .tulbox-modal-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
</style>

