<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Modal USA
    const openUsa = document.getElementById('openUsaModalBtn');
    const closeUsa = document.getElementById('closeUsaModalBtn');
    const closeUsaSec = document.getElementById('closeUsaModalBtnSec');
    const modalUsa = document.getElementById('usaCorpModal');

    function toggleUsa(show) {
      if (modalUsa) {
        modalUsa.classList.toggle('active', show);
        document.body.style.overflow = show ? 'hidden' : '';
      }
    }

    if (openUsa) openUsa.addEventListener('click', () => toggleUsa(true));
    if (closeUsa) closeUsa.addEventListener('click', () => toggleUsa(false));
    if (closeUsaSec) closeUsaSec.addEventListener('click', () => toggleUsa(false));
    if (modalUsa) {
      modalUsa.addEventListener('click', (e) => {
        if (e.target === modalUsa) toggleUsa(false);
      });
    }

    // Modal Tulbox
    const openTul = document.getElementById('openTulboxModalBtn');
    const closeTul = document.getElementById('closeTulboxModalBtn');
    const closeTulSec = document.getElementById('closeTulboxModalBtnSec');
    const modalTul = document.getElementById('tulboxModal');

    function toggleTul(show) {
      if (modalTul) {
        modalTul.classList.toggle('active', show);
        document.body.style.overflow = show ? 'hidden' : '';
      }
    }

    if (openTul) openTul.addEventListener('click', () => toggleTul(true));
    if (closeTul) closeTul.addEventListener('click', () => toggleTul(false));
    if (closeTulSec) closeTulSec.addEventListener('click', () => toggleTul(false));
    if (modalTul) {
      modalTul.addEventListener('click', (e) => {
        if (e.target === modalTul) toggleTul(false);
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleUsa(false);
        toggleTul(false);
      }
    });
  });
</script>

