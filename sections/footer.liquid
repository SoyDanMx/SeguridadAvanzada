{% comment %}
  FOOTER MODERNO Y DINÁMICO - SEGURIDAD AVANZADA
  Incluye: Info empresa, Whatsapp dinámico, Enlaces, Newsletter y Reseñas de Google Integradas.
{% endcomment %}

<style>
  .footer-moderno {
    background-color: #121212; 
    color: #94a3b8;
    padding: 5rem 2rem 2rem;
    font-family: inherit;
    border-top: 4px solid #2A75D3; 
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.5fr 1.5fr; /* Ajustado para dar espacio a las reseñas */
      gap: 3rem;
    }
  }

  .footer-heading {
    color: #f8fafc;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Info Empresa */
  .footer-brand h2 {
    color: #ffffff;
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
  }
  
  .footer-brand p {
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .footer-contact-list svg {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    stroke: #3b82f6; 
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-contact-list a {
    color: #e2e8f0;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact-list a:hover {
    color: #3b82f6;
  }

  /* Badge General de Google */
  .footer-reviews-badge {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    background-color: #1e293b;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid #334155;
    transition: transform 0.3s ease, border-color 0.3s ease;
    text-decoration: none;
  }

  .footer-reviews-badge:hover {
    transform: translateY(-3px);
    border-color: #3b82f6;
  }

  .google-logo-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .footer-reviews-stars {
    display: flex;
    gap: 2px;
    margin-bottom: 2px;
  }

  .footer-reviews-stars svg {
    width: 16px;
    height: 16px;
    fill: #FABB05; 
  }

  .footer-reviews-text {
    font-size: 0.9rem;
    line-height: 1.3;
    color: #94a3b8;
  }

  .footer-reviews-text strong {
    color: #ffffff;
    font-size: 1.05rem;
  }

  /* Tarjetas de Reseñas Individuales */
  .review-card {
    background-color: #1e293b;
    border-left: 3px solid #3b82f6;
    padding: 1.2rem;
    border-radius: 6px;
    margin-bottom: 1.2rem;
  }

  .review-card-text {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #cbd5e1;
    font-style: italic;
    margin-bottom: 0.8rem;
  }

  .review-card-author {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .review-card-name {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Enlaces */
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 1rem;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 1.05rem;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #3b82f6;
    transform: translateX(5px);
  }

  /* Newsletter */
  .footer-newsletter-text {
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .footer-form-group {
    display: flex;
    position: relative;
  }

  .footer-input {
    width: 100%;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    border: 1px solid #334155;
    background-color: #1e293b;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .footer-input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  .footer-btn {
    position: absolute;
    right: 5px;
    top: 5px;
    bottom: 5px;
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .footer-btn:hover {
    background-color: #2563eb;
  }

  /* Bottom */
  .footer-bottom {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      text-align: center;
    }
  }

  .footer-socials {
    display: flex;
    gap: 1.5rem;
  }

  .footer-socials a {
    color: #64748b;
    transition: color 0.3s ease, transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e293b;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .footer-socials a:hover {
    color: #ffffff;
    background: #3b82f6;
    transform: translateY(-3px);
  }

  .footer-socials svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Delaware USA Corp Card & Modal Styles */
  .usa-corp-card {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 12px;
    padding: 1.25rem;
    margin-top: 1.5rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    position: relative;
    overflow: hidden;
    text-align: left;
  }

  .usa-corp-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.05), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .usa-corp-card:hover::before {
    transform: translateX(100%);
  }

  .usa-corp-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.6);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.15);
  }

  .usa-corp-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #f8fafc;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .usa-flag-pulse {
    font-size: 1.4rem;
    animation: flagPulse 2s infinite alternate;
  }

  @keyframes flagPulse {
    0% { transform: scale(1); }
    100% { transform: scale(1.15); filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.5)); }
  }

  .usa-corp-card-body {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0 0 1rem 0 !important;
  }

  .usa-corp-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 600;
    color: #3b82f6;
  }

  .arrow-right-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .usa-corp-card:hover .arrow-right-icon {
    transform: translateX(5px);
  }

  /* Modal Overlay styling with glassmorphism */
  .usa-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 1.5rem;
  }

  .usa-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Modal Container styling */
  .usa-modal-container {
    background: radial-gradient(circle at top left, #1e293b 0%, #0f172a 100%);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 20px;
    width: 100%;
    max-width: 580px;
    padding: 2.5rem 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 40px rgba(59, 130, 246, 0.15);
    position: relative;
    transform: scale(0.9);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .usa-modal-overlay.active .usa-modal-container {
    transform: scale(1);
  }

  .usa-modal-glow {
    position: absolute;
    top: -150px;
    left: -150px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .usa-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .usa-modal-close:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #ef4444;
    transform: rotate(90deg);
  }

  .usa-modal-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .usa-modal-flag {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.3));
  }

  .usa-modal-header h2 {
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .usa-modal-subtitle {
    color: #3b82f6;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .usa-modal-badge {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .usa-modal-body {
    text-align: center;
  }

  .usa-modal-description {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .usa-modal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 480px) {
    .usa-modal-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .usa-modal-feature {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: left;
    transition: background 0.3s ease;
  }

  .usa-modal-feature:hover {
    background: rgba(30, 41, 59, 0.8);
  }

  .usa-feature-icon {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .usa-modal-feature h3 {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .usa-modal-feature p {
    color: #94a3b8;
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0;
  }

  .usa-corp-specs {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-row span {
    color: #64748b;
  }

  .spec-row strong {
    color: #f8fafc;
    font-weight: 600;
  }

  .usa-modal-disclaimer {
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 1.5rem 0 0 0;
  }

  .usa-modal-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 480px) {
    .usa-modal-footer {
      flex-direction: row;
    }
  }

  .usa-modal-btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    color: #ffffff !important;
    border: none;
    border-radius: 10px;
    padding: 0.85rem 1.75rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-grow: 2;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
  }

  .usa-modal-btn-primary:hover {
    background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
  }

  .usa-modal-btn-primary svg {
    transition: transform 0.3s ease;
  }

  .usa-modal-btn-primary:hover svg {
    transform: translate(2px, -2px);
  }

  .usa-modal-btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    border-radius: 10px;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-grow: 1;
  }

  .usa-modal-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
</style>

<footer class="footer-moderno">
  <div class="footer-container">
    <div class="footer-grid">
      
      <div class="footer-brand">
        {% if request.locale.iso_code == 'en' %}
          <h3 class="footer-heading" style="margin-bottom: 1rem; color: #ffffff;">About Us</h3>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 1rem;">
            Experts in design, sale and execution of Industrial Security, CCTV, Access Control, Networks and Renewable Energy projects. We provide world-class integrated solutions for corporates and industries in Mexico and the USA.
          </p>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 1rem;">
            <strong>{{ shop.name }}</strong> is proudly part of the corporate group:
          </p>
          
          <!-- Nuo Networks White Logo Link (EN) -->
          <a href="https://www.nuo-networks.com/" target="_blank" style="display: inline-block; margin-bottom: 1.5rem; outline: none; transition: all 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'; this.style.filter='drop-shadow(0 0 8px rgba(59,130,246,0.5))';" onmouseout="this.style.transform='none'; this.style.filter='none';">
            <img src="{{ 'nuo-networks-logo-white.png' | asset_url }}" alt="Nuo Networks, Inc." style="height: 38px; max-width: 100%; object-fit: contain; display: block;">
          </a>
          
          <!-- Delaware US C-Corp Card (EN) -->
          <div class="usa-corp-card" id="openUsaModalBtn">
            <div class="usa-corp-card-header">
              <span class="usa-flag-pulse">🇺🇸</span>
              <strong>Located in the United States?</strong>
            </div>
            <p class="usa-corp-card-body">
              We are established in Delaware, US. We can process and fulfill your purchase within the USA through our C-Corp.
            </p>
            <div class="usa-corp-card-footer">
              <span>View Corporate Details</span>
              <svg class="arrow-right-icon" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="#3b82f6" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
          </div>
        {% else %}
          <h3 class="footer-heading" style="margin-bottom: 1rem; color: #ffffff;">Sobre Nosotros</h3>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 1rem;">
            Expertos en diseño, venta y ejecución de proyectos de Seguridad Industrial, CCTV, Control de Acceso, Redes y Energía Renovable. Brindamos soluciones integrales de clase mundial para corporativos e industrias en México y USA.
          </p>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 1rem;">
            <strong>{{ shop.name }}</strong> forma parte orgullosamente del corporativo:
          </p>
          
          <!-- Nuo Networks White Logo Link (ES) -->
          <a href="https://www.nuo-networks.com/" target="_blank" style="display: inline-block; margin-bottom: 1.5rem; outline: none; transition: all 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'; this.style.filter='drop-shadow(0 0 8px rgba(59,130,246,0.5))';" onmouseout="this.style.transform='none'; this.style.filter='none';">
            <img src="{{ 'nuo-networks-logo-white.png' | asset_url }}" alt="Nuo Networks, Inc." style="height: 38px; max-width: 100%; object-fit: contain; display: block;">
          </a>
          
          <!-- Delaware US C-Corp Card (ES) -->
          <div class="usa-corp-card" id="openUsaModalBtn">
            <div class="usa-corp-card-header">
              <span class="usa-flag-pulse">🇺🇸</span>
              <strong>¿Te ubicas en Estados Unidos?</strong>
            </div>
            <p class="usa-corp-card-body">
              Somos una empresa establecida en Delaware, US. Podemos gestionar tu compra dentro de EE.UU. con nuestra C-Corp.
            </p>
            <div class="usa-corp-card-footer">
              <span>Ver detalles corporativos</span>
              <svg class="arrow-right-icon" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="#3b82f6" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
          </div>
        {% endif %}
        
        <ul class="footer-contact-list">
          {% if section.settings.phone != blank %}
          <li>
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <div>
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
              {% if section.settings.whatsapp != blank %}
                <br><a href="https://wa.me/{{ section.settings.whatsapp | remove: ' ' | remove: '+' }}?text=Deseo%20Informacion%20de%20sistemas%20de%20seguridad" target="_blank" style="color: #25D366; font-weight: 600;">WhatsApp MX: {{ section.settings.whatsapp }}</a>
              {% endif %}
              <br><a href="https://wa.me/14243553283?text=Hello,%20I'm%20interested%20in%20purchasing%20equipment%20in%20the%20US" target="_blank" style="color: #25D366; font-weight: 600;">WhatsApp USA: +1 (424) 355-3283</a>
            </div>
          </li>
          {% endif %}
          
          {% if section.settings.email != blank %}
          <li>
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              <br><a href="mailto:contact@nuo-networks.com" style="opacity: 0.85; font-size: 0.95em;">Email USA: contact@nuo-networks.com</a>
            </div>
          </li>
          {% endif %}
        </ul>

        {% if section.settings.show_google_reviews %}
        {% assign reviews_url = section.settings.google_reviews_link | default: "https://share.google/Uoxv3RTwBKQKuGyHZ" %}
        <a href="{{ reviews_url }}" target="_blank" class="footer-reviews-badge">
