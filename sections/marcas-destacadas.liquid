    </div>

    <!-- FILA 2 (Scroll Hacia la Derecha) -->
    <div class="marcas-track track-reverse">
      {% for i in (1..2) %}
        <!-- AUFIT -->
        <a href="/search?q=AUFIT" class="marca-card" title="AUFIT">
          <div class="marca-content">
            <svg class="marca-logo-svg" viewBox="0 0 140 36">
