</section>

{% schema %}
{
  "name": "Marcas Destacadas",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Marcas Destacadas"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Distribuidores autorizados de las marcas líderes en seguridad electrónica y telecomunicaciones."
    }
  ],
  "presets": [
    {
      "name": "Marcas Destacadas"
    }
  ]
}
{% endschema %}
