            <svg class="marca-logo-svg" viewBox="0 0 140 36">
              <text x="50%" y="26" text-anchor="middle" font-family="'Arial Black', Impact, system-ui, sans-serif" font-size="24" font-weight="900" font-style="italic" fill="#0f172a" letter-spacing="1.5">FAAC</text>
            </svg>
          </div>
        </a>

        <!-- CyberPower -->
        <a href="/search?q=CyberPower" class="marca-card" title="CyberPower">
