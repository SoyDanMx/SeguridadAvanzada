{% comment %}
  SECCIÓN: COMUNIDAD DE FACEBOOK (ESTILO VANGUARDIA)
  Integración fluida de Facebook Page Feed y Videos con diseño 2 columnas,
  lazy-loading por IntersectionObserver y responsividad avanzada.
{% endcomment %}

{% style %}
  .fb-community-{{ section.id }} {
    background: linear-gradient(135deg, #0b1329 0%, #152238 50%, #0d1b2a 100%);
    color: #ffffff;
    padding: 5rem 1.5rem;
    position: relative;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .fb-community-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(24, 119, 242, 0.15) 0%, rgba(0,0,0,0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .fb-community-container-{{ section.id }} {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 991px) {
    .fb-community-container-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* Columna Izquierda: Información */
  .fb-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(24, 119, 242, 0.15);
    border: 1px solid rgba(24, 119, 242, 0.4);
    color: #60a5fa;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .fb-badge-dot {
    width: 8px;
    height: 8px;
    background-color: #1877f2;
    border-radius: 50%;
    box-shadow: 0 0 10px #1877f2;
    animation: fbPulse 2s infinite;
  }

  @keyframes fbPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(24, 119, 242, 0.7); }
    70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(24, 119, 242, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(24, 119, 242, 0); }
  }

  .fb-heading {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1.2rem 0;
    background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .fb-heading { font-size: 2.1rem; }
  }

  .fb-subheading {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 2.5rem;
  }

  .fb-features-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    width: 100%;
  }

  .fb-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.2rem 1.5rem;
    border-radius: 16px;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .fb-feature-item:hover {
    transform: translateY(-3px);
    border-color: rgba(24, 119, 242, 0.5);
    background: rgba(255, 255, 255, 0.06);
  }

  .fb-feature-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, #1877f2 0%, #0052cc 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 12px rgba(24, 119, 242, 0.3);
  }

  .fb-feature-content h4 {
    margin: 0 0 0.3rem 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .fb-feature-content p {
    margin: 0;
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.45;
  }

  .fb-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: linear-gradient(135deg, #1877f2 0%, #0d59c6 100%);
    color: #ffffff !important;
    padding: 1.1rem 2.2rem;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none !important;
    box-shadow: 0 8px 24px rgba(24, 119, 242, 0.4);
    transition: all 0.3s ease;
  }

  .fb-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(24, 119, 242, 0.6);
    background: linear-gradient(135deg, #2582ff 0%, #1565e6 100%);
  }

  /* Columna Derecha: Facebook Player Container */
  .fb-widget-col {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .fb-card-glass {
    width: 100%;
    max-width: 500px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 1.25rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(24, 119, 242, 0.15);
    backdrop-filter: blur(16px);
    overflow: hidden;
    position: relative;
    min-height: 520px;
  }

  .fb-card-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .fb-card-header svg {
    width: 28px;
    height: 28px;
    fill: #1877f2;
  }

  .fb-card-header span {
    font-size: 0.95rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 0.02em;
  }

  /* Skeleton Loading State */
  .fb-skeleton {
    width: 100%;
    height: 480px;
    border-radius: 12px;
    background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%);
    background-size: 200% 100%;
    animation: fbShimmer 1.8s infinite;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    color: #64748b;
  }

  @keyframes fbShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .fb-page-wrapper {
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #ffffff;
    min-height: 480px;
  }

  .fb-page, .fb-page iframe {
    width: 100% !important;
    border: none !important;
    border-radius: 12px !important;
  }
{% endstyle %}

<section class="fb-community-{{ section.id }}" id="fb-community-{{ section.id }}">
  <div class="fb-community-container-{{ section.id }}">
    
    <!-- Columna Izquierda: Información y Beneficios -->
    <div class="fb-info-col">
      {% if section.settings.badge_text != blank %}
        <div class="fb-badge">
          <span class="fb-badge-dot"></span>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="fb-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="fb-subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="fb-features-list">
        {% if section.settings.feature_1_title != blank %}
          <div class="fb-feature-item">
            <div class="fb-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <div class="fb-feature-content">
              <h4>{{ section.settings.feature_1_title }}</h4>
              <p>{{ section.settings.feature_1_text }}</p>
            </div>
          </div>
        {% endif %}

        {% if section.settings.feature_2_title != blank %}
          <div class="fb-feature-item">
            <div class="fb-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
            </div>
            <div class="fb-feature-content">
              <h4>{{ section.settings.feature_2_title }}</h4>
              <p>{{ section.settings.feature_2_text }}</p>
            </div>
          </div>
        {% endif %}

        {% if section.settings.feature_3_title != blank %}
          <div class="fb-feature-item">
            <div class="fb-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div class="fb-feature-content">
              <h4>{{ section.settings.feature_3_title }}</h4>
              <p>{{ section.settings.feature_3_text }}</p>
            </div>
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" class="fb-cta-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>{{ section.settings.button_label }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- Columna Derecha: Tarjeta de Widget Facebook -->
    <div class="fb-widget-col">
      <div class="fb-card-glass">
        <div class="fb-card-header">
          <svg viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Comunidad Oficial en Facebook</span>
        </div>

        <div class="fb-page-wrapper">
          <div id="fb-skeleton-{{ section.id }}" class="fb-skeleton">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            <span>Cargando feed y videos de Facebook...</span>
          </div>

          <!-- Plugin de Página de Facebook (XFBML / iFrame) -->
          <div 
            class="fb-page" 
            data-href="{{ section.settings.facebook_url }}" 
            data-tabs="{{ section.settings.facebook_tabs }}" 
            data-width="500" 
            data-height="{{ section.settings.facebook_height }}" 
            data-small-header="false" 
            data-adapt-container-width="true" 
            data-hide-cover="false" 
            data-show-facepile="true">
            <blockquote cite="{{ section.settings.facebook_url }}" class="fb-xfbml-parse-ignore">
              <a href="{{ section.settings.facebook_url }}">Seguridad Avanzada</a>
            </blockquote>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Lazy loading script via IntersectionObserver -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var sectionEl = document.getElementById('fb-community-{{ section.id }}');
    var skeletonEl = document.getElementById('fb-skeleton-{{ section.id }}');

    if (!sectionEl) return;

    function loadFacebookSDK() {
      if (window.FB) {
        window.FB.XFBML.parse(sectionEl);
        if (skeletonEl) skeletonEl.style.display = 'none';
        return;
      }

      if (!document.getElementById('facebook-jssdk')) {
        var js = document.createElement('script');
        js.id = 'facebook-jssdk';
        js.src = 'https://connect.facebook.net/es_LA/sdk.js#xfbml=1&version=v19.0';
        js.async = true;
        js.defer = true;
        js.onload = function() {
          if (skeletonEl) skeletonEl.style.display = 'none';
        };
        document.body.appendChild(js);
      } else {
        setTimeout(function() {
          if (window.FB) window.FB.XFBML.parse(sectionEl);
          if (skeletonEl) skeletonEl.style.display = 'none';
        }, 800);
      }
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            loadFacebookSDK();
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '200px 0px' });
      observer.observe(sectionEl);
    } else {
      loadFacebookSDK();
    }
  });
</script>

{% schema %}
{
  "name": "Comunidad Facebook",
  "tag": "section",
  "class": "section-facebook-community",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto de la insignia/Badge",
      "default": "Nuestra Comunidad Principal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título Principal",
      "default": "Únete a la red de Seguridad Avanzada en Facebook"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo / Descripción",
      "default": "Miles de clientes y técnicos confían en nuestra página de Facebook para recibir actualizaciones y demostraciones en tiempo real:"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Beneficio 1 - Título",
      "default": "Videos & Pruebas en Vivo"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "Beneficio 1 - Descripción",
      "default": "Demostraciones en tiempo real de cámaras CCTV, control de acceso y novedades tecnológicas."
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Beneficio 2 - Título",
      "default": "Ofertas & Promociones Exclusivas"
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "Beneficio 2 - Descripción",
      "default": "Descuentos directos y lanzamientos publicados en nuestra red antes que en cualquier otro lugar."
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Beneficio 3 - Título",
      "default": "Casos de Éxito & Asesoría"
    },
    {
      "type": "text",
      "id": "feature_3_text",
      "label": "Beneficio 3 - Descripción",
      "default": "Proyectos reales de instalación y atención personalizada a través de nuestro equipo."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etiqueta del Botón CTA",
      "default": "Seguir en Facebook"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "URL de la Página de Facebook",
      "default": "https://www.facebook.com/seguridadavanzadacdmx/"
    },
    {
      "type": "select",
      "id": "facebook_tabs",
      "label": "Pestañas a Mostrar",
      "options": [
        { "value": "timeline", "label": "Feed / Publicaciones y Videos (Timeline)" },
        { "value": "events", "label": "Eventos" },
        { "value": "messages", "label": "Mensajes" }
      ],
      "default": "timeline"
    },
    {
      "type": "number",
      "id": "facebook_height",
      "label": "Altura del reproductor (px)",
      "default": 500
    }
  ],
  "presets": [
    {
      "name": "Comunidad Facebook",
      "category": "Social Media"
    }
  ]
}
{% endschema %}
