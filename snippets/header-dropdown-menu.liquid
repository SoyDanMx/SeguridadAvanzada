<style>
  /* Base del Menú Horizontal Principal */
  .sa-nav-inline {
    display: inline-flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
  }

  .sa-menu-link {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #1e293b;
    text-transform: uppercase;
    padding: 1.5rem 1.5rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  .sa-menu-link:hover { color: #2563eb; }

  /* Contenedor del Mega Menú (Full-Width moderno) */
  .sa-has-mega {
    position: static;
  }

  .sa-mega-wrapper {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100vw;
    background: #ffffff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    border-top: 1px solid #f1f5f9;
    border-bottom: 3px solid #2A75D3;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 999;
    padding: 4rem 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
    /* Retraso al OCULTAR para dar tiempo al usuario de mover el mouse */
    transition-delay: 0.35s;
  }

  /* Puente invisible: cierra el gap entre el enlace y el panel desplegable */
  .sa-mega-wrapper::before {
    content: "";
    position: absolute;
    top: -30px;
    left: 0;
    right: 0;
    height: 30px;
    background: transparent;
  }

  /* Mostrar con Hover Suave - SIN retraso al mostrar */
  .sa-has-mega:hover > .sa-mega-wrapper,
  .sa-mega-wrapper:hover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  /* Grid del Contenido interno */
  .sa-mega-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 3fr 1.2fr; /* Izquierda Categorías, Derecha Publicidad */
    gap: 4rem;
  }

  /* Grid de Categorías (3 Columnas de enlaces) */
  .sa-categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  .sa-cat-group-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #0f172a;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sa-subcat-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .sa-subcat-link {
    font-size: 1.35rem;
    color: #475569;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    transition: all 0.2s ease;
  }
  .sa-subcat-link:hover {
    color: #2563eb;
    transform: translateX(4px);
  }

  /* Badges de Venta (Atracción de clics) */
  .sa-badge {
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .sa-badge-hot { background-color: #fee2e2; color: #ef4444; }
  .sa-badge-new { background-color: #dbeafe; color: #2563eb; }

  /* Columna Derecha: Tarjeta de Solución Tecnológica (Showcase) */
  .sa-menu-showcase {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 12px;
    padding: 2.5rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.2);
    position: relative;
    overflow: hidden;
  }

  .sa-menu-showcase::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200px;
    height: 200px;
    background: rgba(37, 99, 235, 0.15);
    border-radius: 50%;
    filter: blur(40px);
  }

  .sa-showcase-tag {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    align-self: flex-start;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .sa-showcase-title {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 1rem 0;
    color: #ffffff;
  }

  .sa-showcase-desc {
    font-size: 1.2rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .sa-showcase-btn {
    background-color: #2563eb;
    color: #ffffff;
    text-decoration: none;
    padding: 1rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1.2rem;
    text-align: center;
    transition: background 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .sa-showcase-btn:hover { background-color: #1d4ed8; }
</style>

