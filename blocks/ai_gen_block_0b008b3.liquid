    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Color de texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Radio de borde",
      "default": 4
    },
    {
      "type": "header",
      "content": "Botón"
    },
