    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Radio de borde",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de descripción",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Color título producto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color de precio",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "vendor_color",
      "label": "Color de proveedor",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno de sección",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio bajo encabezado",
