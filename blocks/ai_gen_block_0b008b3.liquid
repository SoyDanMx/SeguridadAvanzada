      "unit": "px",
      "label": "Tamaño de precio",
      "default": 18
    },
    {
      "type": "header",
      "content": "Insignias"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Mostrar insignias",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Texto de oferta",
      "default": "Oferta"
    },
    {
      "type": "text",
      "id": "sold_out_badge_text",
