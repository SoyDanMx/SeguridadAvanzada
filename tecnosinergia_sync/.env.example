# ==============================================================================
# ENTORNO Y CREDENCIALES: TECNOSINERGIA → SHOPIFY SYNC PIPELINE
# ==============================================================================

# 1. BANXICO SIE API (Tipo de cambio USD/MXN)
# Solicitar token gratuito en: https://www.banxico.org.mx/SieAPIRest/service/v1/
BANXICO_SIE_TOKEN="tu_token_banxico_aqui"

# 2. TECNOSINERGIA API (Catálogo de productos)
# API V3 (Principal - Header api-token):
TECNOSINERGIA_API_TOKEN="tu_token_v3_tecnosinergia"

# API V2 (Fallback - Token en URL):
TECNOSINERGIA_V2_TOKEN="tu_token_v2_tecnosinergia"

# 3. SHOPIFY ADMIN API (GraphQL)
# Dominio de la tienda Shopify (ej. seguridad-avanzada.myshopify.com)
SHOPIFY_STORE_DOMAIN="seguridad-avanzada.myshopify.com"

# Access Token del Admin API (con permisos read_products, write_products, read_inventory, write_inventory)
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxx"

# Versión del API Admin GraphQL (default: 2024-07)
SHOPIFY_API_VERSION="2024-07"

# 4. REGLAS DE NEGOCIO Y CONFIGURACIÓN OPCIONAL
# Usar tipo de cambio SAT DOF (FIX del día hábil anterior) en lugar del FIX del día actual (true/false)
USE_SAT_DOF_PREVIOUS_DAY_FX="false"

# Umbral máximo de días de tiempo de entrega para sobre pedidos antes de pasar a DRAFT (default: 60)
MAX_LEAD_TIME_DAYS="60"
