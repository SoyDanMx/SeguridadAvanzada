// Prisma schema - PostgreSQL (Supabase)
// Genera cliente: npx prisma generate
// Migraciones: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?  @db.Text
  price_usd   Float
  price_mxn   Float
  stock       Int      @default(0)
  brand       String?
  image_url   String?
  category    String?
  last_updated DateTime @updatedAt

  @@index([sku])
  @@index([category])
}
